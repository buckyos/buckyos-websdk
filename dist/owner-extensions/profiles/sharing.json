        "effect": "write"
      }
    },
    "revoke": {
      "description": "Withdraw an availability grant.",
      "input": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string",
            "enum": [
              "availability"
            ]
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "slot",
          "to"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object"
      },
      "x-buckyos:action": {
        "effect": "write"
      }
    }
  }
}
